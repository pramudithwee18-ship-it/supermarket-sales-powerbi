{
  "name": "UrbanBasket Dark",
  "dataColors": [
    "#2BB673", "#F08C5A", "#B5AE7E", "#5FD1A4", "#E8B04B", "#6C9BD2",
    "#C77DCE", "#8FD14F", "#FF6F61", "#4FC1E9", "#A0A4B8", "#F2D16B"
  ],
  "background": "#2E3142",
  "foreground": "#FFFFFF",
  "tableAccent": "#2BB673",
  "good": "#2BB673",
  "neutral": "#E8B04B",
  "bad": "#FF6F61",
  "maximum": "#2BB673",
  "center": "#E8B04B",
  "minimum": "#2E3142",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Bold", "color": "#FFFFFF" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#FFFFFF" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#FFFFFF" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#C9CCD6" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1F2130" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#1F2130" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#2E3142" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#3A3E54" } }, "radius": 12 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "alignment": "center",
          "fontSize": 12,
          "bold": true
        }],
        "visualHeader": [{
          "show": true,
          "background": { "solid": { "color": "#2E3142" } },
          "foreground": { "solid": { "color": "#FFFFFF" } }
        }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#C9CCD6" } },
          "titleColor": { "solid": { "color": "#C9CCD6" } },
          "gridlineShow": false
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#C9CCD6" } },
          "titleColor": { "solid": { "color": "#C9CCD6" } },
          "gridlineColor": { "solid": { "color": "#4A4F68" } },
          "gridlineStyle": "dotted"
        }],
        "legend": [{ "labelColor": { "solid": { "color": "#C9CCD6" } } }],
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "card": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2BB673" } }, "radius": 6 }],
        "labels": [{ "color": { "solid": { "color": "#1F2130" } }, "fontSize": 24 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#1F2130" } }, "fontSize": 11 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#2E3142" } }, "transparency": 0 }],
        "header": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "bold": true }],
        "items": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "background": { "solid": { "color": "#2E3142" } }
        }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#262838" } }
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#2E3142" } }
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorPrimary": { "solid": { "color": "#2E3142" } },
          "fontColorSecondary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#34384C" } }
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "backColor": { "solid": { "color": "#262838" } }
        }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
